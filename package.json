{
  "name": "@knorby/inkeedecoder-client",
  "version": "0.2.0",
  "description": "A universal TypeScript client for scraping data from inkeedecoder.com — products, ingredients, search, brands, and ingredient functions.",
  "license": "Apache-2.0",
  "author": "knorby",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knorby/inkeedecoder-client.git"
  },
  "homepage": "https://github.com/knorby/inkeedecoder-client#readme",
  "bugs": {
    "url": "https://github.com/knorby/inkeedecoder-client/issues"
  },
  "keywords": [
    "inkeedecoder",
    "skincare",
    "ingredients",
    "scraper",
    "cosmetics",
    "inci",
    "react-native"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "css-select": "^5.2.2",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "htmlparser2": "^12.0.0"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && node -e \"require('fs').copyFileSync('dist/index.d.ts','dist/index.d.cts')\"",
    "dev": "tsup --watch",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "INKEEDECODER_LIVE=1 vitest run --config vitest.live.config.ts",
    "release": "npm run build && changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,jsx,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": "true"
  }
}
